{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "No-Pause"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "Vercel Dev (Full Stack)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vercel", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
